#!/usr/bin/env bash
# Fast pre-check for the formal suite: no kernel constant may be declared in
# two namespaces.  Ansatz refuses a second declaration ("Constant already
# declared"), but only when the second namespace loads — after half an hour
# of elaboration.  This finds such clashes in seconds, by scanning the
# sources for the literal declaration forms:
#   (thm N  (kdef N  (thm* N  (kdef* N  (pthm N  (a/defn N
#   prove-theorem 'N  base/thm 'N  (b/kdef! 'N  (kdef! 'N
#   prove! 'N  prove-n! 'N  prove-exp! 'N  prove-exp-lv! 'N
#   case! 'N  prove-template! 'N  rv-proj! 'N  rvl-proj! 'N ...
# The surveyed first-argument installer helpers also include case-thm!,
# simple-case!, sb-thm!, sb-simple!, vs-thm!, vw-thm!, rv-inversion!,
# prove-step!, pack-step!, pack!, split-proof!, prove-agree!, prove-closed!,
# instantiate-closed!, unfold-eq!, unfold-at!, kdef-fn!, and define!.
# All these heads take the installed name in argument 1.  Generators such
# as define-fielded! instead receive names in later arguments and are not
# matched when those names are computed, nor are names built by doseq/str.
# The quoted heads also match qualified calls and eval/list-built calls.
# Names built by generators (doseq loops, str) are not seen; the suite itself
# still catches those.
# Usage: bin/check-formal-names [DIR]   (default: formal/lcert/formal)
dir="${1:-$(dirname "$0")/../formal/lcert/formal}"
dups=$(grep -oE "(\((thm|kdef|thm\*|kdef\*|pthm|a/defn) |(prove-theorem|base/thm|kdef!|prove!|prove-n!|prove-exp!|prove-exp-lv!|case!|prove-template!|rv-proj!|rvl-proj!|rv-inversion!|case-thm!|simple-case!|sb-thm!|sb-simple!|vs-thm!|vw-thm!|prove-step!|pack-step!|pack!|split-proof!|prove-agree!|prove-closed!|instantiate-closed!|unfold-eq!|unfold-at!|kdef-fn!|define!) '+)[A-Za-z][A-Za-z0-9_']*" "$dir"/*.clj \
  | sed -E "s/^([^:]*):.*[ ']([A-Za-z][A-Za-z0-9_']*)$/\2 \1/" \
  | sort -u | awk '{n[$1]++; f[$1]=f[$1] " " $2} END {for (k in n) if (n[k] > 1) print k ":" f[k]}')
if [ -n "$dups" ]; then
  echo "Kernel constants declared in more than one namespace:" >&2
  echo "$dups" >&2
  exit 1
fi
