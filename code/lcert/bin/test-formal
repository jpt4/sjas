#!/usr/bin/env bash
# Formal suite (ADR-0006): kernel-checks the formalization of the metatheory.
#   bin/test-formal                 every suite (lcert.formal-test/suites)
#   bin/test-formal prop434 erase   only the named suites (and what they load)
# A suite lcert.formal-test.X requires the formal namespace lcert.formal.X,
# which kernel-checks every declaration in it and in everything it needs.
cd "$(dirname "$0")/.." || exit 2
# Kernel-name clashes between namespaces fail here in seconds, not at load.
bin/check-formal-names || exit 1
export ANSATZ_OFFLINE=1
exec clojure -J-Xmx2g -M:formal bin/test-formal.clj "$@"
