#!/usr/bin/env bash
# Start the warm checking server (test-formal/lcert/formal_server.clj): one
# slow first load of the whole formalization, then fast re-checks with
# bin/formal-check.  Detached; log and PID under test-runs/.  Port 5699.
cd "$(dirname "$0")/.." || exit 2
bin/check-formal-names || exit 1
mkdir -p test-runs
[ -f test-runs/formal-server.pid ] && kill "$(cat test-runs/formal-server.pid)" 2>/dev/null
ANSATZ_OFFLINE=1 nohup clojure -J-Xmx2g -J-Dclojure.server.repl="{:port 5699 :accept clojure.core.server/repl}" -M:formal \
  -e "(require 'lcert.formal-server) (println :warming) (lcert.formal-server/warm!) (println :ready) @(promise)" \
  > test-runs/formal-server.log 2>&1 &
echo $! > test-runs/formal-server.pid
echo "formal server starting (PID $(cat test-runs/formal-server.pid)); progress: tail -f test-runs/formal-server.log"
